# Copiar a .env y completar. No versionar el .env real.

# Puerto del servidor HTTP (Render inyecta PORT en producción)
PORT=3000

# Entorno
NODE_ENV=development

# PostgreSQL — Supabase connection string (rol de runtime, sin BYPASSRLS)
DATABASE_URL="postgresql://user:password@db.YOUR_PROJECT.supabase.co:5432/postgres?schema=public"

# Orígenes permitidos del frontend (sin barra final). Varios: separados por coma.
CORS_ORIGIN="http://localhost:5173,https://TU-APP.vercel.app"

# Opcional: regex para previews de Vercel (URL distinta por PR). Requiere CORS_ORIGIN en producción.
# CORS_ORIGIN_PATTERN="^https://[a-z0-9-]+(?:--[a-z0-9-]+)?\\.vercel\\.app$"

# --- Checkpoint 02+ (no requeridos para el setup inicial) ---

# Supabase — validación de JWT en la API
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_JWT_SECRET="your-jwt-secret"

# Mercado Pago OAuth (marketplace)
# MP_CLIENT_ID=""
# MP_CLIENT_SECRET=""
# MP_WEBHOOK_SECRET=""

# IA — Claude API (solo backend/worker)
# ANTHROPIC_API_KEY=""
