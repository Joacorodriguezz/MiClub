# Copiar a .env y completar. No versionar el .env real.

# Puerto del servidor HTTP (Render inyecta PORT en producción)
PORT=3000

# Entorno
NODE_ENV=development

# GET /ready usa esta conexión (SELECT 1). El middleware de auth no la usa.
DATABASE_URL="postgresql://user:password@db.YOUR_PROJECT.supabase.co:5432/postgres?schema=public"

# Auth y withTenant. Rol LOGIN, sin SUPERUSER ni BYPASSRLS, miembro de miclub_app.
# Si falta, GET /session responde 503 y no cae a DATABASE_URL.
RUNTIME_DATABASE_URL="postgresql://miclub_runtime:password@db.YOUR_PROJECT.supabase.co:5432/postgres?schema=public"

# Orígenes permitidos del frontend (sin barra final). Varios: separados por coma.
CORS_ORIGIN="http://localhost:5173,https://TU-APP.vercel.app"

# Opcional: regex para previews de Vercel (URL distinta por PR). Requiere CORS_ORIGIN en producción.
# CORS_ORIGIN_PATTERN="^https://[a-z0-9-]+(?:--[a-z0-9-]+)?\\.vercel\\.app$"

# --- Checkpoint 02+ (no requeridos para el setup inicial) ---

# Supabase Auth. El secret es el JWT Secret del proyecto, no la anon key.
# Mínimo 32 caracteres. Sin estos valores, GET /session responde 503.
# Cada request autenticado manda el club elegido en X-Organization-Id.
# La API lo acepta solo si el usuario del token es miembro. No confía en el header solo.
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_JWT_SECRET=""

# Mercado Pago OAuth (marketplace)
# MP_CLIENT_ID=""
# MP_CLIENT_SECRET=""
# MP_WEBHOOK_SECRET=""

# IA — Claude API (solo backend/worker)
# ANTHROPIC_API_KEY=""
