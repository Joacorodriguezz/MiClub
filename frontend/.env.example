# Copiar a .env.local y completar. No versionar el .env real.
# Solo variables publicables: el bundle del frontend las expone al navegador.

# Supabase Auth (administradores). Dejar estos placeholders, o vacías, hace que
# /ingresar no llame a ningún servicio. Completar con el proyecto real.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# URL de la API (sin barra final).
# Local: el backend escucha en el puerto 3000.
# Vercel: reemplazar por la URL pública de Render después del deploy.
VITE_API_URL="http://localhost:3000"
